# Nunca coloque esta chave no navegador ou em commits.
GROQ_API_KEY=

# Configuracoes opcionais
PORT=3000
HOST=127.0.0.1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
ALEX_WEB_SEARCH=true

# Voz neural local gratuita (Kokoro)
KOKORO_TTS_URL=http://127.0.0.1:8787/v1/audio/speech
KOKORO_HEALTH_URL=http://127.0.0.1:8787/health
KOKORO_TTS_VOICE=pm_alex
KOKORO_TTS_SPEED=0.94
ALEX_TTS_AUTOSTART=true

